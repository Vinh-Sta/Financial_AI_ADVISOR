# Copy this file to ".env" and fill in your key

# Required: used by the AI Coach AND Jev category classification
# (Jev runs through OpenRouter's Decisions API - no separate TypeSafe key needed)
OPENROUTER_API_KEY=

# Optional: pin a specific Jev model (default: typesafe/jev-1.13)
# JEV_MODEL=typesafe/jev-1.13